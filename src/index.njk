---
layout: null
---
<!DOCTYPE html>
<html class="scroll-smooth" lang="es">
<head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<meta name="description" content="{{ homepage.seo_description }}">
<title>{{ homepage.title }}</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
<script id="tailwind-config">
tailwind.config = {
  darkMode:"class",
  theme:{extend:{"colors":{"background":"#f9f9f9","on-background":"#1b1b1b","primary":"#000000","on-primary":"#ffffff","primary-container":"#1b1b1b","on-primary-container":"#848484","secondary":"#5f5e5e","on-secondary":"#ffffff","surface-container":"#eeeeee","surface-container-high":"#e8e8e8","outline-variant":"#cfc4c5","on-surface":"#1b1b1b","surface":"#f9f9f9"},"borderRadius":{"DEFAULT":"1rem","lg":"2rem","full":"9999px"},"fontFamily":{"hero-title":["Inter"],"body-main":["Inter"]}}}
}
</script>
<style>
  body{font-family:'Inter',sans-serif;background-color:#f9f9f9;color:#1b1b1b;}
  .material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24;}

  /* ── CAROUSEL ── */
  .carousel-track{display:flex;gap:1.5rem;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding-bottom:1rem;cursor:grab;}
  .carousel-track::-webkit-scrollbar{display:none;}
  .carousel-track.dragging{cursor:grabbing;user-select:none;}
  .case-card{flex:0 0 340px;scroll-snap-align:start;border-radius:1.25rem;padding:2rem;display:flex;flex-direction:column;justify-content:space-between;min-height:420px;transition:transform .2s,box-shadow .2s;}
  .case-card:hover{transform:translateY(-4px);box-shadow:0 20px 40px rgba(0,0,0,.12);}
  @media(max-width:640px){.case-card{flex:0 0 85vw;}}

  /* ── LIGHTBOX ── */
  #lb-overlay{position:fixed;inset:0;background:rgba(0,0,0,.75);backdrop-filter:blur(6px);z-index:1000;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .3s;}
  #lb-overlay.open{opacity:1;pointer-events:all;}
  #lb-panel{background:#fff;border-radius:1.5rem;width:min(780px,92vw);max-height:88vh;overflow-y:auto;padding:2.5rem;position:relative;transform:translateY(24px);transition:transform .3s;}
  #lb-overlay.open #lb-panel{transform:translateY(0);}
  #lb-close{position:sticky;top:0;float:right;background:#1b1b1b;color:#fff;border:none;border-radius:9999px;width:36px;height:36px;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:18px;line-height:1;flex-shrink:0;}
  .lb-star-section{margin-top:1.5rem;}
  .lb-star-label{font-size:.65rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:#888;margin-bottom:.35rem;}
  .lb-star-text{font-size:.95rem;line-height:1.7;color:#333;}
  .lb-metric-pill{display:inline-flex;flex-direction:column;align-items:center;background:#f3f3f3;border-radius:.75rem;padding:.6rem 1rem;min-width:90px;}
  .lb-metric-val{font-size:1.4rem;font-weight:700;line-height:1;}
  .lb-metric-lbl{font-size:.6rem;text-transform:uppercase;letter-spacing:.08em;color:#888;margin-top:.2rem;text-align:center;}
</style>
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body class="bg-background text-on-background antialiased">

<!-- Header -->
<header class="fixed top-0 left-0 right-0 z-50 bg-background/80 backdrop-blur-md border-b border-outline-variant">
<div class="max-w-[1100px] mx-auto px-6 h-16 flex items-center justify-between">
  <p class="text-sm font-semibold tracking-tight">Fernando Lopez — Marketing Portfolio</p>
  <div class="flex gap-6">
    <a class="text-xs font-medium uppercase tracking-widest hover:opacity-60 transition-opacity" href="#work">Work</a>
    <a class="text-xs font-medium uppercase tracking-widest hover:opacity-60 transition-opacity" href="#about">About</a>
    <a class="text-xs font-medium uppercase tracking-widest hover:opacity-60 transition-opacity" href="#contact">Contact</a>
  </div>
</div>
</header>

<main class="max-w-[1100px] mx-auto px-6 pt-32 space-y-[120px]">

  <!-- Hero -->
  <section class="flex flex-col md:flex-row gap-12 items-center">
    <div class="flex-1 space-y-8">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-secondary">{{ homepage.hero.eyebrow }}</p>
      <h1 class="text-[56px] md:text-[64px] font-bold leading-[1.1] tracking-[-0.02em]">
        {{ homepage.hero.title_line1 }}<br><span class="text-secondary">{{ homepage.hero.title_line2 }}</span><br>{{ homepage.hero.title_line3 }}
      </h1>
      <p class="text-secondary text-lg max-w-lg">{{ homepage.hero.description }}</p>
      <div class="flex gap-4 flex-wrap">
        <a href="#work" class="bg-primary text-on-primary px-8 py-4 rounded-full font-bold text-sm tracking-[0.015em] hover:opacity-80 transition-opacity">Ver Casos de Estudio</a>
        <a href="mailto:{{ homepage.contact.email }}" class="bg-surface-container text-on-surface px-8 py-4 rounded-full font-bold text-sm tracking-[0.015em] hover:bg-surface-container-high transition-colors">Contactar</a>
      </div>
    </div>
    <div class="w-full md:w-[380px] aspect-[4/5] overflow-hidden rounded-lg bg-surface-container">
      <img alt="Fernando G. López Cañas" class="w-full h-full object-cover grayscale" src="/assets/images/hero-portrait.jpg">
    </div>
  </section>

  <!-- About -->
  <section class="grid grid-cols-1 md:grid-cols-4 gap-8 border-t border-outline-variant pt-12" id="about">
    {% for item in homepage.about %}
    <div><p class="text-xs text-secondary mb-2 uppercase font-bold tracking-widest">{{ item.title }}</p><p class="font-medium">{{ item.description }}</p></div>
    {% endfor %}
  </section>

  <!-- Metrics -->
  <section class="grid grid-cols-2 md:grid-cols-3 gap-4">
    {% for m in homepage.metrics %}
    <div class="bg-primary-container text-on-primary p-8 md:p-10 rounded-lg flex flex-col justify-center items-center text-center">
      <h3 class="text-3xl md:text-5xl font-bold mb-2">{{ m.value }}</h3>
      <p class="text-xs font-medium uppercase tracking-widest text-on-primary-container">{{ m.label }}</p>
    </div>
    {% endfor %}
  </section>

  <!-- Cases Carousel -->
  <section class="space-y-8" id="work">
    <div class="flex items-end justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-secondary mb-1">STAR+ Method</p>
        <h2 class="text-3xl font-bold tracking-tight">Casos de Estudio</h2>
      </div>
      <div class="flex gap-2">
        <button id="carousel-prev" aria-label="Anterior" class="w-10 h-10 rounded-full border border-outline-variant flex items-center justify-center hover:bg-surface-container transition-colors disabled:opacity-30">
          <span class="material-symbols-outlined text-[20px]">chevron_left</span>
        </button>
        <button id="carousel-next" aria-label="Siguiente" class="w-10 h-10 rounded-full border border-outline-variant flex items-center justify-center hover:bg-surface-container transition-colors disabled:opacity-30">
          <span class="material-symbols-outlined text-[20px]">chevron_right</span>
        </button>
      </div>
    </div>

    <!-- Carousel track -->
    <div class="carousel-track" id="carousel-track">
      {%- set palette = [
        {bg:"#E3F2FD",text:"#0D47A1",badge:"rgba(13,71,161,0.08)",btn:"#0D47A1"},
        {bg:"#E8F5E9",text:"#1B5E20",badge:"rgba(27,94,32,0.08)",btn:"#1B5E20"},
        {bg:"#F3E5F5",text:"#4A148C",badge:"rgba(74,20,140,0.08)",btn:"#4A148C"},
        {bg:"#FFF3E0",text:"#E65100",badge:"rgba(230,81,0,0.08)",btn:"#E65100"},
        {bg:"#E0F2F1",text:"#004D40",badge:"rgba(0,77,64,0.08)",btn:"#004D40"},
        {bg:"#FCE4EC",text:"#880E4F",badge:"rgba(136,14,79,0.08)",btn:"#880E4F"},
        {bg:"#FFF8E1",text:"#FF6F00",badge:"rgba(255,111,0,0.08)",btn:"#FF6F00"},
        {bg:"#E8EAF6",text:"#1A237E",badge:"rgba(26,35,126,0.08)",btn:"#1A237E"}
      ] -%}
      {% for caso in collections.casos %}
        {%- set ci = loop.index0 % 8 -%}
        {%- set col = palette[ci] -%}
        <article class="case-card" 
          style="background:{{ col.bg }};"
          data-case-id="{{ loop.index0 }}"
          role="button"
          tabindex="0">
          <!-- Card header -->
          <div>
            <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:1rem;">
              <span style="font-size:.6rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;background:{{ col.badge }};color:{{ col.text }};padding:.3rem .75rem;border-radius:9999px;">{{ caso.data.eyebrow }}</span>
            </div>
            <p style="font-size:.7rem;font-weight:600;text-transform:uppercase;letter-spacing:.1em;color:{{ col.text }};opacity:.6;margin-bottom:.4rem;">{{ caso.data.company }} · {{ caso.data.period }}</p>
            <h3 style="font-size:1.2rem;font-weight:700;line-height:1.25;color:#1b1b1b;margin-bottom:1rem;">{{ caso.data.title }}</h3>
            <p style="font-size:.85rem;line-height:1.6;color:#444;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden;">{{ caso.data.summary }}</p>
          </div>
          <!-- Card metrics + CTA -->
          <div style="margin-top:1.5rem;">
            {% if caso.data.metrics %}
            <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:.5rem;margin-bottom:1.25rem;">
              {% for m in caso.data.metrics | slice(2) %}
              <div style="background:rgba(255,255,255,.6);border-radius:.6rem;padding:.5rem .75rem;">
                <div style="font-size:1.1rem;font-weight:700;color:#1b1b1b;">{{ m.value }}</div>
                <div style="font-size:.6rem;text-transform:uppercase;letter-spacing:.06em;color:#666;">{{ m.label }}</div>
              </div>
              {% endfor %}
            </div>
            {% endif %}
            <button class="read-more-btn" 
              style="background:{{ col.btn }};color:#fff;border:none;border-radius:9999px;padding:.6rem 1.25rem;font-size:.78rem;font-weight:700;letter-spacing:.04em;cursor:pointer;display:flex;align-items:center;gap:.4rem;"
              data-case-id="{{ loop.index0 }}"
              aria-label="Leer caso completo: {{ caso.data.title }}">
              Leer caso completo
              <span class="material-symbols-outlined" style="font-size:16px;">arrow_forward</span>
            </button>
          </div>
        </article>
      {% endfor %}
    </div>

    <!-- Carousel dots -->
    <div id="carousel-dots" class="flex justify-center gap-2 mt-4">
      {% for caso in collections.casos %}
      <button class="carousel-dot w-2 h-2 rounded-full bg-outline-variant transition-all" data-dot="{{ loop.index0 }}" aria-label="Ir al caso {{ loop.index0 + 1 }}"></button>
      {% endfor %}
    </div>
  </section>

  <!-- Stack -->
  <section class="space-y-6">
    <h2 class="text-3xl font-bold tracking-tight">Stack & Metodología</h2>
    <div class="flex flex-wrap gap-3">
      {% for s in homepage.stack %}
      <span class="px-5 py-2.5 bg-surface-container rounded-full text-sm font-medium">{{ s.tool }}</span>
      {% endfor %}
    </div>
  </section>

  <!-- Philosophy -->
  <section class="py-20 border-y border-outline-variant">
    <div class="max-w-3xl">
      <p class="text-xs text-secondary mb-6 uppercase tracking-[0.2em] font-bold">{{ homepage.philosophy.eyebrow }}</p>
      <h2 class="text-4xl font-semibold leading-tight">{{ homepage.philosophy.quote }}</h2>
      <p class="mt-8 text-secondary text-base leading-relaxed">{{ homepage.philosophy.description }}</p>
    </div>
  </section>

  <!-- Contact -->
  <section class="pb-32 text-center" id="contact">
    <div class="inline-flex items-center gap-2 mb-8 bg-green-100 text-green-800 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest">
      <span class="relative flex h-2 w-2"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span><span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span></span>
      {{ homepage.contact.badge }}
    </div>
    <h2 class="text-5xl md:text-6xl font-bold mb-12 tracking-tight">{{ homepage.contact.title }}</h2>
    <div class="flex flex-col md:flex-row justify-center gap-8 items-center">
      <a class="text-2xl font-medium border-b-2 border-primary pb-1 hover:opacity-60 transition-opacity" href="mailto:{{ homepage.contact.email }}">{{ homepage.contact.email }}</a>
      <a class="text-sm font-bold uppercase tracking-widest hover:opacity-60 transition-opacity" href="{{ homepage.contact.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>
    </div>
  </section>

</main>

<!-- Floating Nav -->
<nav class="fixed bottom-8 left-1/2 -translate-x-1/2 z-50">
  <div class="bg-black/90 backdrop-blur-xl px-6 py-3 rounded-full flex items-center gap-8 shadow-2xl border border-white/10">
    <a class="text-white hover:text-gray-300 transition-colors" href="#"><span class="material-symbols-outlined text-[20px]">home</span></a>
    <a class="text-white hover:text-gray-300 transition-colors" href="#work"><span class="material-symbols-outlined text-[20px]">grid_view</span></a>
    <a class="text-white hover:text-gray-300 transition-colors" href="#about"><span class="material-symbols-outlined text-[20px]">person</span></a>
    <a class="text-white hover:text-gray-300 transition-colors" href="#contact"><span class="material-symbols-outlined text-[20px]">mail</span></a>
  </div>
</nav>

<footer class="max-w-[1100px] mx-auto px-6 py-12 flex justify-between border-t border-outline-variant text-xs text-secondary">
  <p>© 2026 Fernando G. López Cañas</p>
  <p>Growth Marketing · Strategic Communications · San Salvador, El Salvador</p>
</footer>

<!-- ══════════ LIGHTBOX ══════════ -->
<div id="lb-overlay" role="dialog" aria-modal="true" aria-labelledby="lb-title">
  <div id="lb-panel">
    <button id="lb-close" aria-label="Cerrar">✕</button>
    <div id="lb-content"></div>
  </div>
</div>

<!-- ══════════ CASE DATA (JSON) ══════════ -->
<script id="cases-data" type="application/json">
[
  {% for caso in collections.casos %}
  {
    "title": {{ caso.data.title | dump | safe }},
    "company": {{ caso.data.company | dump | safe }},
    "period": {{ caso.data.period | dump | safe }},
    "eyebrow": {{ caso.data.eyebrow | dump | safe }},
    "tags": {{ caso.data.tags | dump | safe }},
    "summary": {{ caso.data.summary | dump | safe }},
    "metrics": {{ caso.data.metrics | dump | safe }},
    "situation": {{ caso.data.situation | dump | safe }},
    "task": {{ caso.data.task | dump | safe }},
    "action": {{ caso.data.action | dump | safe }},
    "result": {{ caso.data.result | dump | safe }},
    "learning": {{ caso.data.learning | dump | safe }}
  }{% if not loop.last %},{% endif %}
  {% endfor %}
]
</script>

<script>
(function(){
  // ── Data ──
  const CASES = JSON.parse(document.getElementById('cases-data').textContent);

  // ── Palette (same order as Nunjucks) ──
  const PALETTE = [
    {bg:"#E3F2FD",text:"#0D47A1"},{bg:"#E8F5E9",text:"#1B5E20"},
    {bg:"#F3E5F5",text:"#4A148C"},{bg:"#FFF3E0",text:"#E65100"},
    {bg:"#E0F2F1",text:"#004D40"},{bg:"#FCE4EC",text:"#880E4F"},
    {bg:"#FFF8E1",text:"#FF6F00"},{bg:"#E8EAF6",text:"#1A237E"}
  ];

  // ── Lightbox ──
  const overlay = document.getElementById('lb-overlay');
  const content = document.getElementById('lb-content');
  const closeBtn = document.getElementById('lb-close');

  function openLightbox(idx) {
    const c = CASES[idx];
    const col = PALETTE[idx % 8];
    const metricsHTML = (c.metrics||[]).map(m =>
      `<div class="lb-metric-pill"><span class="lb-metric-val">${m.value}</span><span class="lb-metric-lbl">${m.label}</span></div>`
    ).join('');
    const tagsHTML = (c.tags||[]).map(t =>
      `<span style="font-size:.7rem;font-weight:600;padding:.25rem .6rem;border-radius:9999px;background:${col.bg};color:${col.text};">${t}</span>`
    ).join('');

    content.innerHTML = `
      <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.5rem;flex-wrap:wrap;">
        <span style="font-size:.6rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;background:${col.bg};color:${col.text};padding:.25rem .7rem;border-radius:9999px;">${c.eyebrow}</span>
      </div>
      <p style="font-size:.75rem;font-weight:600;text-transform:uppercase;letter-spacing:.1em;color:#888;margin-bottom:.4rem;">${c.company} · ${c.period}</p>
      <h2 id="lb-title" style="font-size:1.6rem;font-weight:700;line-height:1.2;margin-bottom:1rem;">${c.title}</h2>
      <div style="display:flex;flex-wrap:wrap;gap:.4rem;margin-bottom:1.25rem;">${tagsHTML}</div>
      ${metricsHTML ? `<div style="display:flex;flex-wrap:wrap;gap:.75rem;margin-bottom:1.5rem;">${metricsHTML}</div>` : ''}
      <hr style="border:none;border-top:1px solid #eee;margin:1.25rem 0;">
      <div class="lb-star-section"><p class="lb-star-label">S — Situación</p><p class="lb-star-text">${c.situation||''}</p></div>
      <div class="lb-star-section"><p class="lb-star-label">T — Tarea</p><p class="lb-star-text">${c.task||''}</p></div>
      <div class="lb-star-section"><p class="lb-star-label">A — Acción</p><p class="lb-star-text">${c.action||''}</p></div>
      <div class="lb-star-section"><p class="lb-star-label">R — Resultado</p><p class="lb-star-text">${c.result||''}</p></div>
      ${c.learning ? `<div class="lb-star-section" style="background:#f9f9f9;border-radius:.75rem;padding:1rem 1.25rem;"><p class="lb-star-label">+ Aprendizaje Clave</p><p class="lb-star-text">${c.learning}</p></div>` : ''}
    `;
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  }

  function closeLightbox() {
    overlay.classList.remove('open');
    document.body.style.overflow = '';
  }

  closeBtn.addEventListener('click', closeLightbox);
  overlay.addEventListener('click', e => { if (e.target === overlay) closeLightbox(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });

  // Wire up buttons and cards
  document.querySelectorAll('.read-more-btn').forEach(btn => {
    btn.addEventListener('click', e => { e.stopPropagation(); openLightbox(+btn.dataset.caseId); });
  });
  document.querySelectorAll('.case-card').forEach(card => {
    card.addEventListener('click', () => openLightbox(+card.dataset.caseId));
    card.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') openLightbox(+card.dataset.caseId); });
  });

  // ── Carousel ──
  const track = document.getElementById('carousel-track');
  const dots = document.querySelectorAll('.carousel-dot');
  const CARD_W = 340 + 24; // card width + gap

  function updateDots() {
    const idx = Math.round(track.scrollLeft / CARD_W);
    dots.forEach((d, i) => {
      d.style.background = i === idx ? '#1b1b1b' : '#cfc4c5';
      d.style.width = i === idx ? '1.5rem' : '.5rem';
    });
  }

  document.getElementById('carousel-prev').addEventListener('click', () => {
    track.scrollBy({ left: -CARD_W, behavior: 'smooth' });
  });
  document.getElementById('carousel-next').addEventListener('click', () => {
    track.scrollBy({ left: CARD_W, behavior: 'smooth' });
  });
  dots.forEach((d, i) => {
    d.addEventListener('click', () => track.scrollTo({ left: i * CARD_W, behavior: 'smooth' }));
  });
  track.addEventListener('scroll', updateDots, { passive: true });
  updateDots();

  // Drag-to-scroll
  let isDown=false, startX=0, scrollLeft=0;
  track.addEventListener('mousedown', e => { isDown=true; track.classList.add('dragging'); startX=e.pageX-track.offsetLeft; scrollLeft=track.scrollLeft; });
  track.addEventListener('mouseleave', () => { isDown=false; track.classList.remove('dragging'); });
  track.addEventListener('mouseup', () => { isDown=false; track.classList.remove('dragging'); });
  track.addEventListener('mousemove', e => { if(!isDown) return; e.preventDefault(); const x=e.pageX-track.offsetLeft; track.scrollLeft=scrollLeft-(x-startX)*1.5; });

  // Netlify Identity
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", u => { if(!u) window.netlifyIdentity.on("login", () => { document.location.href="/admin/"; }); });
  }
})();
</script>
</body>
</html>
